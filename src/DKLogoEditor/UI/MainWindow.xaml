<Window x:Class="DKLogoEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DKLogoEditor.UI"
        Title="DK Logo Editor — AI Candidates"
        Width="820"
        Height="760"
        MinWidth="700"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DK Logo Editor"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="  AI Candidates"
                           FontSize="12"
                           Foreground="#666666"
                           VerticalAlignment="Bottom"
                           Margin="6,0,0,2" />
            </StackPanel>
            <Button Content="설정"
                    Width="72"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="SettingsButton_Click" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="110" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>

                <TextBlock Text="원본" FontWeight="SemiBold" Margin="0,0,0,8" />
                <local:ZoomPanImageViewer x:Name="SourcePreview"
                                           Grid.Row="1"
                                           ViewportChanged="SourcePreview_ViewportChanged" />

                <TextBlock Grid.Row="3"
                           Text="AI 후보 3개 — 클릭하여 선택"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Candidate1Button"
                            Grid.Column="0"
                            Tag="0"
                            Padding="4"
                            IsEnabled="False"
                            Click="CandidateButton_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image x:Name="Candidate1Image" Stretch="Uniform" />
                            <TextBlock Grid.Row="1" Text="후보 1" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="Candidate2Button"
                            Grid.Column="2"
                            Tag="1"
                            Padding="4"
                            IsEnabled="False"
                            Click="CandidateButton_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image x:Name="Candidate2Image" Stretch="Uniform" />
                            <TextBlock Grid.Row="1" Text="후보 2" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="Candidate3Button"
                            Grid.Column="4"
                            Tag="2"
                            Padding="4"
                            IsEnabled="False"
                            Click="CandidateButton_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image x:Name="Candidate3Image" Stretch="Uniform" />
                            <TextBlock Grid.Row="1" Text="후보 3" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </Grid>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="6" Text="선택 결과" FontWeight="SemiBold" Margin="0,0,0,8" />
                <local:ZoomPanImageViewer x:Name="ResultPreview"
                                           Grid.Row="7"
                                           ViewportChanged="ResultPreview_ViewportChanged" />
            </Grid>

            <StackPanel Grid.Column="2">
                <Button x:Name="ImageSelectButton"
                        Content="이미지 선택"
                        Height="36"
                        Margin="0,0,0,18"
                        Click="ImageSelectButton_Click" />

                <TextBlock Text="배경" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="ColorBackgroundRadioButton"
                                 Content="색상"
                                 GroupName="BackgroundMode"
                                 IsChecked="True" />
                    <RadioButton x:Name="TransparentBackgroundRadioButton"
                                 Content="투명"
                                 GroupName="BackgroundMode"
                                 Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel x:Name="BackgroundColorPanel" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackgroundColorTextBox"
                                 Grid.Column="0"
                                 Text="#FFFFFF"
                                 Height="30"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="BackgroundColorPickerButton"
                                Grid.Column="2"
                                Height="30"
                                ToolTip="색상 선택"
                                Click="BackgroundColorPickerButton_Click">
                            <Border x:Name="BackgroundColorSwatch"
                                    Width="18"
                                    Height="18"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Background="White" />
                        </Button>
                    </Grid>
                    <Popup x:Name="BackgroundColorPickerPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=BackgroundColorPickerButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                BorderBrush="#A0A0A0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,4,0,0">
                            <local:ColorPickerControl x:Name="BackgroundColorPicker"
                                                      SelectedColorChanged="BackgroundColorPicker_SelectedColorChanged" />
                        </Border>
                    </Popup>
                </StackPanel>

                <TextBlock Text="부기명" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="SubtitleTextBox"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16" />

                <TextBlock Text="출력 크기" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputWidthTextBox"
                             Grid.Column="0"
                             Text="200"
                             Height="30"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="OutputHeightTextBox"
                             Grid.Column="2"
                             Text="60"
                             Height="30"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="ModelComboBox"
                          Height="30"
                          Margin="0,0,0,22"
                          DisplayMemberPath="DisplayName" />

                <Button x:Name="GenerateButton"
                        Content="후보 3개 생성"
                        Height="40"
                        Margin="0,0,0,8"
                        IsEnabled="False"
                        Click="GenerateCandidatesButton_Click" />

                <TextBlock x:Name="GenerationStatusTextBlock"
                           Text="AI 후보 생성 모드"
                           FontSize="11"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Button x:Name="SaveAsButton"
                        Content="선택본 다른 이름으로 저장"
                        Height="36"
                        IsEnabled="False"
                        Click="SaveAsButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
