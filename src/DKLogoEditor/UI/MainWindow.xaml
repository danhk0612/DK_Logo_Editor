<Window x:Class="DKLogoEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DKLogoEditor.UI"
        Title="DK Logo Editor"
        Width="720"
        Height="650"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="DK Logo Editor"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="설정"
                    Width="72"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="SettingsButton_Click" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="원본" FontWeight="SemiBold" Margin="0,0,0,8" />
                <local:ZoomPanImageViewer x:Name="SourcePreview"
                                           Grid.Row="1"
                                           ViewportChanged="SourcePreview_ViewportChanged" />

                <TextBlock Grid.Row="3" Text="결과" FontWeight="SemiBold" Margin="0,0,0,8" />
                <local:ZoomPanImageViewer x:Name="ResultPreview"
                                           Grid.Row="4"
                                           ViewportChanged="ResultPreview_ViewportChanged" />
            </Grid>

            <StackPanel Grid.Column="2">
                <Button x:Name="ImageSelectButton"
                        Content="이미지 선택"
                        Height="36"
                        Margin="0,0,0,18"
                        Click="ImageSelectButton_Click" />

                <TextBlock Text="배경" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="ColorBackgroundRadioButton"
                                 Content="색상"
                                 GroupName="BackgroundMode"
                                 IsChecked="True" />
                    <RadioButton x:Name="TransparentBackgroundRadioButton"
                                 Content="투명"
                                 GroupName="BackgroundMode"
                                 Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel x:Name="BackgroundColorPanel" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackgroundColorTextBox"
                                 Grid.Column="0"
                                 Text="#FFFFFF"
                                 Height="30" />
                        <Button x:Name="BackgroundColorPickerButton"
                                Grid.Column="2"
                                Height="30"
                                ToolTip="색상 선택"
                                Click="BackgroundColorPickerButton_Click">
                            <Border x:Name="BackgroundColorSwatch"
                                    Width="18"
                                    Height="18"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Background="White" />
                        </Button>
                    </Grid>
                    <Popup x:Name="BackgroundColorPickerPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=BackgroundColorPickerButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                BorderBrush="#A0A0A0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,4,0,0">
                            <local:ColorPickerControl x:Name="BackgroundColorPicker"
                                                      SelectedColorChanged="BackgroundColorPicker_SelectedColorChanged" />
                        </Border>
                    </Popup>
                </StackPanel>

                <TextBlock Text="부기명" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="SubtitleTextBox" Height="30" Margin="0,0,0,16" />

                <TextBlock Text="출력 크기" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputWidthTextBox"
                             Grid.Column="0"
                             Text="200"
                             Height="30"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="OutputHeightTextBox"
                             Grid.Column="2"
                             Text="60"
                             Height="30"
                             HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="ModelComboBox"
                          Height="30"
                          Margin="0,0,0,22"
                          DisplayMemberPath="DisplayName" />

                <Button x:Name="GenerateButton"
                        Content="생성 / 편집"
                        Height="40"
                        Margin="0,0,0,10"
                        IsEnabled="False"
                        Click="GenerateButton_Click" />
                <Button x:Name="SaveAsButton"
                        Content="다른 이름으로 저장"
                        Height="36"
                        IsEnabled="False"
                        Click="SaveAsButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
