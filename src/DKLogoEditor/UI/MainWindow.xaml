<Window x:Class="DKLogoEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Logo Editor"
        Width="720"
        Height="650"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="DK Logo Editor"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="설정"
                    Width="72"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="SettingsButton_Click" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="원본" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                    <TextBlock Text="원본 로고 미리보기"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Row="3" Text="결과" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                    <TextBlock Text="결과 미리보기"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="2">
                <Button Content="이미지 선택" Height="36" Margin="0,0,0,18" IsEnabled="False" />

                <TextBlock Text="배경" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="색상" IsChecked="True" Margin="0,0,14,0" />
                    <RadioButton Content="투명" />
                </StackPanel>
                <TextBox Text="#FFFFFF" Height="30" Margin="0,0,0,16" />

                <TextBlock Text="부기명" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Height="30" Margin="0,0,0,16" />

                <TextBlock Text="출력 크기" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="200" Height="30" HorizontalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="60" Height="30" HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox Height="30" Margin="0,0,0,22" IsEnabled="False">
                    <ComboBoxItem Content="설정 후 모델 선택" IsSelected="True" />
                </ComboBox>

                <Button Content="생성 / 편집" Height="40" Margin="0,0,0,10" IsEnabled="False" />
                <Button Content="PNG 저장" Height="36" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
