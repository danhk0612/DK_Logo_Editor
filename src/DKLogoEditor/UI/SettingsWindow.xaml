<Window x:Class="DKLogoEditor.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 - DK Logo Editor"
        Width="540"
        Height="520"
        MinWidth="500"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="OpenRouter API Key" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Height="30" />
                <TextBox x:Name="ApiKeyTextBox" Grid.Column="0" Height="30" Visibility="Collapsed" />
                <Button Grid.Column="2"
                        Width="38"
                        Height="30"
                        Content="👁"
                        FontSize="15"
                        ToolTip="API Key 표시/숨기기"
                        Click="ToggleApiKeyVisibilityButton_Click" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="기본 모델" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="DefaultModelComboBox"
                      Height="30"
                      DisplayMemberPath="DisplayName" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="커스텀 모델" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CustomModelTextBox" Grid.Column="0" Height="30" />
                <Button Grid.Column="2" Content="추가" Height="30" Click="AddCustomModelButton_Click" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="CustomModelsListBox" />
            <Button Grid.Row="2"
                    Content="선택 삭제"
                    Width="90"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="DeleteCustomModelButton_Click" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="90" Height="34" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="저장" Width="90" Height="34" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
