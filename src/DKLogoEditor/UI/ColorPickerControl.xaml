<UserControl x:Class="DKLogoEditor.UI.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="230"
             Height="166"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="10" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>

        <Border x:Name="ColorSurface"
                Grid.Row="0"
                BorderBrush="#808080"
                BorderThickness="1"
                Cursor="Cross"
                MouseLeftButtonDown="ColorSurface_MouseLeftButtonDown"
                MouseLeftButtonUp="ColorSurface_MouseLeftButtonUp"
                MouseMove="ColorSurface_MouseMove">
            <Grid ClipToBounds="True">
                <Border x:Name="HueBase" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SurfaceMarker"
                             Width="12"
                             Height="12"
                             Stroke="White"
                             StrokeThickness="2"
                             Fill="Transparent" />
                </Canvas>
            </Grid>
        </Border>

        <Border x:Name="HueBar"
                Grid.Row="2"
                BorderBrush="#808080"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                MouseLeftButtonUp="HueBar_MouseLeftButtonUp"
                MouseMove="HueBar_MouseMove">
            <Grid ClipToBounds="True">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker"
                               Width="3"
                               Height="18"
                               Fill="White"
                               Stroke="Black"
                               StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
