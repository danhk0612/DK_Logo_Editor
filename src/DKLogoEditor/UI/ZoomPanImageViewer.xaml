<UserControl x:Class="DKLogoEditor.UI.ZoomPanImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             SizeChanged="UserControl_SizeChanged">
    <Border x:Name="ViewportBorder"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="4"
            Background="#FAFAFA"
            ClipToBounds="True"
            Cursor="Arrow"
            MouseWheel="ViewportBorder_MouseWheel"
            MouseLeftButtonDown="ViewportBorder_MouseLeftButtonDown"
            MouseLeftButtonUp="ViewportBorder_MouseLeftButtonUp"
            MouseMove="ViewportBorder_MouseMove"
            LostMouseCapture="ViewportBorder_LostMouseCapture">
        <Grid ClipToBounds="True">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <TextBlock x:Name="PlaceholderTextBlock"
                       Foreground="#777777"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
